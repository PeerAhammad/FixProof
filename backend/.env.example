# Copy this file to .env and add your own key.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated frontend origins. Defaults support local Vite.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds. Keep modest for the hackathon demo.
GEMINI_TIMEOUT=75
